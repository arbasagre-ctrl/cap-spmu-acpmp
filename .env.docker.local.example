APP_NAME="SPMU-ACPMP"
APP_ENV=local
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_PORT=8080
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
SEED_DEMO_USERS=true
RUN_MIGRATIONS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=spmu_acpmp
DB_USERNAME=spmu_application
DB_PASSWORD=REPLACE_WITH_GENERATED_DATABASE_PASSWORD
MARIADB_DATABASE=spmu_acpmp
MARIADB_USER=spmu_application
MARIADB_PASSWORD=REPLACE_WITH_GENERATED_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_GENERATED_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=spmu-acpmp@cspc.edu.ph
MAIL_FROM_NAME="SPMU-ACPMP"

