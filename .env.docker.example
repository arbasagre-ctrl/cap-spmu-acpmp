APP_NAME="SPMU-ACPMP"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_ARTISAN_KEY_GENERATE_SHOW_OUTPUT
APP_DEBUG=false
APP_URL=https://spmu.example.cspc.edu.ph
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
SEED_DEMO_USERS=false
RUN_MIGRATIONS=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=spmu_acpmp
DB_USERNAME=spmu_application
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MARIADB_DATABASE=spmu_acpmp
MARIADB_USER=spmu_application
MARIADB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MARIADB_ROOT_PASSWORD=REPLACE_WITH_SEPARATE_ROOT_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_INSTITUTIONAL_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=spmu-acpmp@cspc.edu.ph
MAIL_FROM_NAME="SPMU-ACPMP"

# Google sign-in (identity only; local SPMU-ACPMP accounts still control access).
# Register the exact redirect URI in Google Cloud Console. Never commit real client secrets.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Required production allow-list when Google sign-in is enabled.
GOOGLE_ALLOWED_DOMAINS=cspc.edu.ph

